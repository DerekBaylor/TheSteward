@namespace TheSteward.Shared.Components.FinanceManagerComponents

@using TheSteward.Core.Dtos.FinanceManagerDtos

<MudCard id="expenseCard" class="ts-tabbed-card" Elevation="0">

    <MudCardActions class="ts-tabbed-card-btn-container">
        @if (!IsReadOnly)
        {
            <MudButton id="openBudgetCategoriesBtn"
                       class="ts-tab-btn budget-categories-btn"
                       StartIcon="@Icons.Material.Filled.Category"
                       OnClick="HandleOpenBudgetCategories">
                Budget Categories
            </MudButton>

            <MudButton id="addExpenseBtn"
                       class="ts-tab-btn add-expense-btn"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="HandleAddExpense">
                Add Expense
            </MudButton>
        }
    </MudCardActions>

    <MudCardContent class="ts-card-content">

        <MudCardHeader Class="ts-tabbed-card-header">
            <CardHeaderContent>
                <h3 class="ts-tabbed-card-title">
                    <span class="ts-label">Expenses</span>
                </h3>
            </CardHeaderContent>
        </MudCardHeader>

        <div class="ts-card-body">
            @if (!Expenses.Any())
            {
                <div class="expense-empty-state">
                    <span class="material-icons expense-empty-icon">receipt_long</span>
                    <p class="expense-empty-text">No expenses added yet.</p>
                </div>
            }
            else
            {
                @foreach (var category in Expenses
                   .GroupBy(e => e.BudgetCategoryId)
                   .OrderBy(g => g.First().BudgetCategory?.DisplayOrder ?? int.MaxValue))
                {
                    var categoryKey = category.Key;
                    var categoryName = category.First().BudgetCategory?.BudgetCategoryName ?? "Uncategorized";
                    var categoryTotal = category.Sum(e => e.AmountDue);
                    var isExpanded = !collapsedCategories.Contains(categoryKey);

                    <section class="ts-card-section expense-category-section">

                        <div class="expense-category-header @(isExpanded ? "" : "expense-category-header--collapsed")"
                             @onclick="() => ToggleCategory(categoryKey)">
                            <div class="expense-category-header-left">
                                <span class="material-icons expense-category-chevron">
                                    @(isExpanded ? "expand_more" : "chevron_right")
                                </span>
                                <span class="expense-category-name">@categoryName</span>
                                <span class="expense-category-count">
                                    @category.Count() item@(category.Count() == 1 ? "" : "s")
                                </span>
                            </div>
                            <span class="expense-category-total">@categoryTotal.ToString("C")</span>
                        </div>

                        @if (isExpanded)
                        {
                            <table class="expense-table">
                                <thead>
                                    <tr>
                                        <th class="expense-th row-expand-th"></th>
                                        <th class="expense-th expense-th-name">Name</th>
                                        <th class="expense-th expense-th-text mobile-hide">Subcategory</th>
                                        <th class="expense-th expense-th-text mobile-hide">Due</th>
                                        <th class="expense-th expense-th-amount">Amount</th>
                                        @if (!IsReadOnly)
                                        {
                                            <th class="expense-th expense-th-action mobile-hide"></th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var expense in category
                                        .OrderBy(e => e.BudgetSubCategory?.DisplayOrder ?? int.MaxValue)
                                        .ThenBy(e => e.DisplayOrder))
                                    {
                                        <tr class="expense-row" @onclick="() => HandleRowView(expense)">
                                            <td class="expense-td row-expand-td">
                                                <button class="row-expand-btn @(IsRowExpanded(expense.ExpenseId) ? "is-expanded" : "")"
                                                        title="Show details"
                                                        @onclick="() => ToggleRowExpand(expense.ExpenseId)"
                                                        @onclick:stopPropagation="true">
                                                    <span class="material-icons">chevron_right</span>
                                                </button>
                                            </td>
                                            <td class="expense-td expense-td-name">
                                                @expense.ExpenseName
                                                @if (expense.LinkedCreditDto != null)
                                                {
                                                    <span class="expense-linked-badge expense-linked-badge--credit"
                                                          title="Linked to credit: @expense.LinkedCreditDto.CreditName">
                                                        <span class="material-icons" style="font-size: 11px;">credit_card</span>
                                                    </span>
                                                }
                                                @if (expense.LinkedInvestmentDto != null)
                                                {
                                                    <span class="expense-linked-badge expense-linked-badge--investment"
                                                          title="Linked to investment: @expense.LinkedInvestmentDto.InvestmentName">
                                                        <span class="material-icons" style="font-size: 11px;">savings</span>
                                                    </span>
                                                }
                                            </td>
                                            <td class="expense-td expense-td-text mobile-hide">
                                                @if (expense.BudgetSubCategory != null)
                                                {
                                                    <span class="expense-sub-badge">
                                                        @expense.BudgetSubCategory.BudgetSubCategoryName
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="expense-td-empty">—</span>
                                                }
                                            </td>
                                            <td class="expense-td expense-td-text expense-td-due mobile-hide">
                                                @(expense.DueDay == 31 ? "Last day" : $"Day {expense.DueDay}")
                                            </td>
                                            <td class="expense-td expense-td-amount">
                                                @expense.AmountDue.ToString("C")
                                            </td>
                                            @if (!IsReadOnly)
                                            {
                                                <td class="expense-td expense-td-action mobile-hide">
                                                    <button class="expense-row-btn expense-row-btn--delete"
                                                            title="Delete"
                                                            @onclick="() => HandleRowDelete(expense)"
                                                            @onclick:stopPropagation="true">
                                                        <span class="material-icons">delete</span>
                                                    </button>
                                                </td>
                                            }
                                        </tr>
                                        @if (IsRowExpanded(expense.ExpenseId))
                                        {
                                            <tr class="row-detail is-open">
                                                <td class="row-detail-cell" colspan="@TotalColumns">
                                                    <div class="row-detail-grid">
                                                        <div class="row-detail-item">
                                                            <span class="row-detail-label">Subcategory</span>
                                                            <span class="row-detail-value">@(expense.BudgetSubCategory?.BudgetSubCategoryName ?? "—")</span>
                                                        </div>
                                                        <div class="row-detail-item">
                                                            <span class="row-detail-label">Due</span>
                                                            <span class="row-detail-value">@(expense.DueDay == 31 ? "Last day" : $"Day {expense.DueDay}")</span>
                                                        </div>
                                                    </div>
                                                    @if (!IsReadOnly)
                                                    {
                                                        <div class="row-detail-actions">
                                                            <button class="expense-row-btn expense-row-btn--edit"
                                                                    title="Edit"
                                                                    @onclick="() => HandleRowEdit(expense)">
                                                                <span class="material-icons">edit</span>
                                                            </button>
                                                            <button class="expense-row-btn expense-row-btn--delete"
                                                                    title="Delete"
                                                                    @onclick="() => HandleRowDelete(expense)">
                                                                <span class="material-icons">delete</span>
                                                            </button>
                                                        </div>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        }

                    </section>
                }

                <!-- Grand Total -->
                <div class="expense-grand-total">
                    <span class="expense-grand-total-label">Total Monthly Expenses</span>
                    <span class="expense-grand-total-value">@Expenses.Sum(e => e.AmountDue).ToString("C")</span>
                </div>
            }
        </div>

    </MudCardContent>
</MudCard>

@code {
    [Parameter, EditorRequired]
    public List<ExpenseDto> Expenses { get; set; } = new();

    [Parameter]
    public bool IsReadOnly { get; set; } = false;

    [Parameter]
    public EventCallback OnAddExpense { get; set; }

    [Parameter]
    public EventCallback OnOpenExpenseDetails { get; set; }

    [Parameter]
    public EventCallback<ExpenseDto> OnEditExpense { get; set; }

    /// <summary>Row tap (any device) — parent opens the item in read-only view mode.</summary>
    [Parameter]
    public EventCallback<ExpenseDto> OnViewExpense { get; set; }

    [Parameter]
    public EventCallback<ExpenseDto> OnDeleteExpense { get; set; }

    [Parameter]
    public EventCallback OnOpenBudgetCategories { get; set; }

    private async Task HandleOpenBudgetCategories() =>
        await OnOpenBudgetCategories.InvokeAsync();

    private readonly HashSet<Guid> collapsedCategories = new();

    private void ToggleCategory(Guid categoryId)
    {
        if (!collapsedCategories.Add(categoryId))
            collapsedCategories.Remove(categoryId);
    }

    private async Task HandleAddExpense() =>
        await OnAddExpense.InvokeAsync();

    private async Task HandleRowEdit(ExpenseDto expense) =>
        await OnEditExpense.InvokeAsync(expense);

    private async Task HandleRowView(ExpenseDto expense) =>
        await OnViewExpense.InvokeAsync(expense);

    private async Task HandleRowDelete(ExpenseDto expense) =>
        await OnDeleteExpense.InvokeAsync(expense);

    /// <summary>Tracks which rows have their mobile detail panel open.</summary>
    private readonly HashSet<Guid> expandedRows = new();

    private int TotalColumns => (IsReadOnly ? 5 : 6);

    private bool IsRowExpanded(Guid expenseId) => expandedRows.Contains(expenseId);

    private void ToggleRowExpand(Guid expenseId)
    {
        if (!expandedRows.Add(expenseId))
            expandedRows.Remove(expenseId);
    }
}
