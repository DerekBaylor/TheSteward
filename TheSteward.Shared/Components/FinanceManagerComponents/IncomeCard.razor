@namespace TheSteward.Shared.Components.FinanceManagerComponents

@using TheSteward.Core.Dtos.FinanceManagerDtos
@using static TheSteward.Shared.Components.FinanceManagerComponents.BaseBudgetCard

<BaseBudgetCard Title="Income"
                HeaderTotals="_headerTotals"
                IsReadOnly="IsReadOnly"
                OnAdd="HandleAddIncome"
                OnDetails="HandleShowIncomeDetails">

    @if (!Incomes.Any())
    {
        <div class="card-empty-state">
            <span class="material-icons card-empty-icon">account_balance_wallet</span>
            <p class="card-empty-text">No income sources added yet.</p>
        </div>
    }
    else
    {
        <section class="ts-card-section">
            <table class="card-table">
                <thead>
                    <tr>
                        <th class="card-th row-expand-th"></th>
                        <th class="card-th th-left">Name</th>
                        <th class="card-th th-right">Monthly Net</th>
                        <th class="card-th th-right mobile-hide">Yearly Net</th>
                        @if (!IsReadOnly)
                        {
                            <th class="card-th card-th-action mobile-hide"></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var income in Incomes)
                    {
                        <tr class="card-table-row" @onclick="() => HandleRowView(income)">
                            <td class="card-td row-expand-td">
                                <button class="row-expand-btn @(IsRowExpanded(income.IncomeId) ? "is-expanded" : "")"
                                        title="Show details"
                                        @onclick="() => ToggleRowExpand(income.IncomeId)"
                                        @onclick:stopPropagation="true">
                                    <span class="material-icons">chevron_right</span>
                                </button>
                            </td>
                            <td class="card-td card-td-1 td-left">@income.IncomeName</td>
                            <td class="card-td card-td-2 td-right">@income.MonthlyNetIncome.ToString("C")</td>
                            <td class="card-td card-td-3 td-right mobile-hide">@((income.MonthlyNetIncome * 12).ToString("C"))</td>
                            @if (!IsReadOnly)
                            {
                                <td class="card-td card-td-action-container mobile-hide">
                                    <button class="card-row-btn card-row-btn--delete"
                                            title="Delete"
                                            @onclick="() => HandleRowDelete(income)"
                                            @onclick:stopPropagation="true">
                                        <span class="material-icons">delete</span>
                                    </button>
                                </td>
                            }
                        </tr>
                        @if (IsRowExpanded(income.IncomeId))
                        {
                            <tr class="row-detail is-open">
                                <td class="row-detail-cell" colspan="@TotalColumns">
                                    <div class="row-detail-grid">
                                        <div class="row-detail-item">
                                            <span class="row-detail-label">Yearly Net</span>
                                            <span class="row-detail-value">@((income.MonthlyNetIncome * 12).ToString("C"))</span>
                                        </div>
                                    </div>
                                    @if (!IsReadOnly)
                                    {
                                        <div class="row-detail-actions">
                                            <button class="card-row-btn card-row-btn--edit"
                                                    title="Edit"
                                                    @onclick="() => HandleRowEdit(income)">
                                                <span class="material-icons">edit</span>
                                            </button>
                                            <button class="card-row-btn card-row-btn--delete"
                                                    title="Delete"
                                                    @onclick="() => HandleRowDelete(income)">
                                                <span class="material-icons">delete</span>
                                            </button>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
                <tfoot>
                    <tr class="card-table-footer">
                        <td class="card-td row-expand-td"></td>
                        <td class="card-td card-td-footer-1 td-left">Total</td>
                        <td class="card-td card-footer-td-2 td-right">
                            @Incomes.Sum(i => i.MonthlyNetIncome).ToString("C")
                        </td>
                        <td class="card-td card-footer-td-3 td-right mobile-hide">
                            @Incomes.Sum(i => i.MonthlyNetIncome * 12).ToString("C")
                        </td>
                        @if (!IsReadOnly)
                        {
                            <td class="card-td mobile-hide"></td>
                        }
                    </tr>
                </tfoot>
            </table>
        </section>
    }

</BaseBudgetCard>

@code {

    [Parameter, EditorRequired]
    public List<IncomeDto> Incomes { get; set; } = new();

    [Parameter]
    public bool IsReadOnly { get; set; } = false;

    [Parameter]
    public EventCallback OnAddIncome { get; set; }

    [Parameter]
    public EventCallback OnOpenIncomeDetails { get; set; }

    [Parameter]
    public EventCallback<IncomeDto> OnEditIncome { get; set; }

    /// <summary>Row tap — parent opens item in read-only view mode.</summary>
    [Parameter]
    public EventCallback<IncomeDto> OnViewIncome { get; set; }

    [Parameter]
    public EventCallback<IncomeDto> OnDeleteIncome { get; set; }

    // ── Header totals ────────────────────────────────────────────────────────────

    private List<BudgetCardTotal> _headerTotals => new()
    {
        new("Monthly", Incomes.Sum(i => i.MonthlyNetIncome).ToString("C")),
        new("Yearly",  Incomes.Sum(i => i.MonthlyNetIncome * 12).ToString("C")),
    };

    // ── Handlers ─────────────────────────────────────────────────────────────────

    private async Task HandleAddIncome()          => await OnAddIncome.InvokeAsync();
    private async Task HandleShowIncomeDetails()  => await OnOpenIncomeDetails.InvokeAsync();
    private async Task HandleRowEdit(IncomeDto i) => await OnEditIncome.InvokeAsync(i);
    private async Task HandleRowView(IncomeDto i) => await OnViewIncome.InvokeAsync(i);
    private async Task HandleRowDelete(IncomeDto i) => await OnDeleteIncome.InvokeAsync(i);

    // ── Row expand ───────────────────────────────────────────────────────────────

    private readonly HashSet<Guid> expandedRows = new();
    private int TotalColumns => IsReadOnly ? 4 : 5;
    private bool IsRowExpanded(Guid id) => expandedRows.Contains(id);

    private void ToggleRowExpand(Guid id)
    {
        if (!expandedRows.Add(id)) expandedRows.Remove(id);
    }
}
